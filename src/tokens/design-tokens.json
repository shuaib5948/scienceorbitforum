{
  "brand": {
    "name": "Science Orbit Forum",
    "shortName": "Science Orbit Forum",
    "wordmark": "SCIENCE ORBIT FORUM",
    "tagline": "Where curiosity orbits knowledge",
    "department": "Department of Science and Technology",
    "institution": "Jamia Madeenathunnoor, Kerala, India",
    "positioning": "An ambitious student science forum with the credibility of an academic institution and the visual quality of a modern international science organization.",
    "personality": [
      "Intelligent",
      "Modern",
      "Scientific",
      "Academic",
      "Curious",
      "Inspiring",
      "Youthful",
      "Professional",
      "Institutional",
      "International"
    ]
  },
  "color": {
    "primary": "#071A2F",
    "secondary": "#1261A0",
    "accent": "#18B6D9",
    "background": {
      "page": "#F7F9FC",
      "navy": "#0A1A33",
      "ink": "#06101F"
    },
    "surface": {
      "card": "#FFFFFF",
      "muted": "#EEF3F8",
      "blue": "#E3EEF8",
      "cyan": "#EAF6FB"
    },
    "text": {
      "default": "#101820",
      "muted": "#44566B",
      "faint": "#7B8A9C",
      "inverse": "#F4F8FC",
      "inverseMuted": "#B9C8D8"
    },
    "border": {
      "default": "#D9E1EA",
      "strong": "#C3CDD9"
    },
    "states": {
      "primaryHover": "#0A1A2E",
      "primaryActive": "#071425",
      "secondaryHover": "#0E4F86",
      "secondaryActive": "#0B3F6C",
      "accentHover": "#10A0C4",
      "accentActive": "#0C8FAE",
      "disabledBg": "#D6DDE6",
      "disabledText": "#9AA6B4"
    }
  },
  "typography": {
    "families": ["Manrope (display / headings)", "Inter (body, UI)"],
    "typeScale": {
      "display": { "size": 64, "lineHeight": 1.02, "tracking": "-2%", "weight": 700 },
      "h1": { "size": 48, "lineHeight": 1.06, "tracking": "-1.8%", "weight": 700 },
      "h2": { "size": 38, "lineHeight": 1.12, "tracking": "-1.5%", "weight": 700 },
      "h3": { "size": 28, "lineHeight": 1.2, "tracking": "-1%", "weight": 600 },
      "h4": { "size": 22, "lineHeight": 1.3, "tracking": "-1%", "weight": 600 },
      "bodyLarge": { "size": 18, "lineHeight": 1.55, "weight": 400 },
      "body": { "size": 16, "lineHeight": 1.6, "weight": 400 },
      "bodySmall": { "size": 14, "lineHeight": 1.5, "weight": 400 },
      "caption": { "size": 13, "lineHeight": 1.4, "weight": 400 },
      "navigation": { "size": 15, "lineHeight": 1.4, "weight": 500 },
      "button": { "size": 15, "lineHeight": 1, "weight": 600 },
      "eyebrow": { "size": 11, "tracking": "12%", "weight": 600, "uppercase": true }
    }
  },
  "spacing": {
    "base": 4,
    "scale": [4, 8, 12, 16, 24, 32, 48, 64, 80, 96, 128, 160]
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "xl": 24,
    "pill": 999
  },
  "shadow": {
    "xs": "0 1px 1px rgba(7,26,47,0.05)",
    "sm": "0 2px 6px rgba(7,26,47,0.07)",
    "md": "0 6px 18px rgba(7,26,47,0.10)",
    "lg": "0 16px 40px rgba(7,26,47,0.14)",
    "accent": "0 6px 18px rgba(18,97,160,0.16)"
  },
  "gridSystem": {
    "columns": { "desktop": 12, "tablet": 8, "mobile": 4 },
    "containerMax": 1240,
    "gutter": { "desktop": 24, "tablet": 20, "mobile": 16 },
    "columnGap": 24,
    "cardGap": 24,
    "sectionPadding": { "desktop": 96, "mobile": 64 }
  },
  "button": {
    "variants": ["primary", "navy", "secondary", "ghost", "inverse"],
    "sizes": { "sm": { "height": 36, "padX": 14, "font": 14 }, "md": { "height": 44, "padX": 20, "font": 15 }, "lg": { "height": 52, "padX": 26, "font": 16 } },
    "radius": 10,
    "stroke": 1.5
  },
  "icon": {
    "strokeWidth": 1.5,
    "sizes": { "xs": 14, "sm": 16, "md": 20, "lg": 24, "xl": 32 },
    "set": ["orbit", "microscope", "atom", "dna", "telescope", "code", "lightbulb", "research", "presentation", "innovation"]
  },
  "motion": {
    "durations": { "fast": 150, "base": 250, "slow": 500 },
    "easing": {
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "standard": "cubic-bezier(0.33, 0, 0.3, 1)"
    },
    "transitions": ["fade", "slide", "scale", "image reveal", "hover movement", "subtle orbital rotation"],
    "orbitalRotation": { "duration": 60000, "accentDuration": 90000 }
  },
  "responsive": {
    "breakpoints": { "mobile": 640, "tablet": 1024, "desktop": 1240 },
    "columns": { "mobile": 4, "tablet": 8, "desktop": 12 }
  }
}